---
import { SITE, waLink } from '../config/site';
const nav = [
  { label: 'Beranda', href: '/' },
  { label: 'Layanan', href: '/layanan/' },
  { label: 'Portofolio', href: '/portofolio/' },
  { label: 'Estimasi Biaya', href: '/estimasi-biaya/' },
  { label: 'Artikel', href: '/artikel/' },
  { label: 'Tentang', href: '/tentang-kami/' },
  { label: 'Kontak', href: '/kontak/' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={SITE.name}>
      <img src="/images/logo.svg" alt="{SITE.name}" class="brand-logo" width="40" height="40" />
      <span class="brand-text">{SITE.name}</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-burger" aria-label="Buka menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Navigasi utama">
      {nav.map((n) => (
        <a
          href={n.href}
          class:list={[{ active: path === n.href || (n.href !== '/' && path.startsWith(n.href)) }]}
        >
          {n.label}
        </a>
      ))}
      <a
        class="nav-cta"
        href={waLink('Halo Interior Batam, saya ingin konsultasi gratis mengenai desain dan pengerjaan interior.')}
        target="_blank"
        rel="noopener"
      >
        <span>💬</span>
        <span>Konsultasi Gratis</span>
      </a>
    </nav>
  </div>
</header>
