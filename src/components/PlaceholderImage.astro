---
interface Props {
  src?: string;
  label: string;
  ratio?: string; // css aspect-ratio, default 16/9
  class?: string;
}
const { src, label, ratio = '16 / 9', class: cls = '' } = Astro.props;
---

{
  src ? (
    <img src={src} alt={label} loading="lazy" class:list={['ph-img', cls]} style={`aspect-ratio:${ratio}`} />
  ) : (
    <div class:list={['ph-img placeholder', cls]} style={`aspect-ratio:${ratio}`} role="img" aria-label={label}>
      <span>{label}</span>
      <small>(placeholder — ganti dengan foto riil)</small>
    </div>
  )
}
