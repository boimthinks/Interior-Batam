---
import PlaceholderImage from './PlaceholderImage.astro';

interface Props {
  href: string;
  title: string;
  description?: string;
  image?: string;
  date?: Date;
}
const { href, title, description, image, date } = Astro.props;
const fmt = date ? date.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
---

<a class="article-card" href={href}>
  <PlaceholderImage label={title} src={image} ratio="4 / 3" />
  <div class="article-card-body">
    <h3>{title}</h3>
    {description && <p>{description}</p>}
    <div class="article-meta">
      {fmt && <time datetime={date!.toISOString()}>{fmt}</time>}
    </div>
  </div>
</a>
