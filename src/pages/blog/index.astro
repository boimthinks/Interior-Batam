---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { SITE } from '../../config/site';

const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Blog & Inspirasi Interior Batam"
  description="Kumpulan studi kasus, panduan teknis, dan inspirasi interior Batam: kitchen set, rumah subsidi, apartemen, ruang tamu, dan ruko komersial."
  keywords={['Artikel Interior Batam', 'Tips Interior Batam']}
>
  <section class="hero hero-page">
    <div class="container">
      <p class="eyebrow">Blog & Edukasi</p>
      <h1>Blog & Inspirasi Interior Batam</h1>
      <p class="lead">Panduan praktis, tips pemilihan material, dan studi kasus lapangan dari tim interior Batam.</p>
    </div>
  </section>

  <section class="container sections">
    <div class="card-grid">
      {articles.map((a) => (
        <ArticleCard
          href={`/blog/${a.id}/`}
          title={a.data.title}
          description={a.data.description}
          image={a.data.heroImage}
          date={a.data.pubDate}
        />
      ))}
    </div>
  </section>
</BaseLayout>
