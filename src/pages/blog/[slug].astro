---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { SITE } from '../../config/site';
import { getCategoryByPillar, SERVICE_CATEGORIES } from '../../config/categories';
import { getPublishedArticles, getRelated } from '../../lib/articles';

export async function getStaticPaths() {
  // Hanya artikel non-draft yang dibangun. Artikel draft tidak menghasilkan
  // halaman sama sekali, jadi tidak ikut terdeploy.
  const articles = await getPublishedArticles();
  return articles.map((article) => {
    const category = getCategoryByPillar(article.data.pillar);

    // Ambil artikel terkait dari kategori/layanan yang sama
    const related = getRelated(articles, article, 4).map((a) => ({
      href: `/blog/${a.id}/`,
      title: a.data.title,
      image: a.data.heroImage,
      date: a.data.pubDate,
    }));

    return {
      params: { slug: article.id },
      props: { article, category, related },
    };
  });
}

const { article, category, related } = Astro.props;
const { Content } = await render(article);
const d = article.data;
const url = new URL(`/blog/${article.id}/`, SITE.domain).href;
---

<ArticleLayout
  title={d.title}
  description={d.description}
  keywords={d.keywords}
  heroImage={d.heroImage}
  pubDate={d.pubDate}
  updatedDate={d.updatedDate}
  author={d.author}
  url={url}
  image={new URL(d.heroImage, SITE.domain).href}
  category={category}
  categories={SERVICE_CATEGORIES}
  relatedArticles={related}
  draft={d.draft}
>
  <Content />
</ArticleLayout>
